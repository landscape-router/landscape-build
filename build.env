# Landscape Build Configuration

# Landscape Router Release Version
# 固定版本（对应 release tag，正式发布均以 v 开头）。
# landscape 会对 landscape_init.toml 里的 version 做强校验（必须与运行版本完全一致），
# 所以升级时必须同步更新 userpatches/overlay/landscape_init-*.toml 中的 version 字段。
LANDSCAPE_VERSION="v0.24.2"

# GitHub Repository URL
LANDSCAPE_REPO="https://github.com/ThisSeanZhang/landscape"

# Kernel Configuration Mode
# set to "yes" to enable interactive kernel configuration menu and auto-save back to userpatches
# set to "no" to use existing config in userpatches without interactive menu
ENABLE_KERNEL_CONFIGURE="no"
# Armbian Build System Configuration
ARMBIAN_REPO="https://github.com/armbian/build.git"
# Specify a tag (e.g., v24.08) or branch (e.g., main)
# v26.5.1 是包含 Orange Pi RV2 (orangepirv2) 支持的首个稳定版本
ARMBIAN_VERSION="v26.5.1"

# Use Tsinghua mirror in customize-image.sh (yes/no)
ENABLE_MIRROR="no"

# 内核编译并行度限制（可选，留空使用 Armbian 默认 -j(CPU*1.5)）
# 内存较小的构建机建议降低该值：8 核 / 16GB 内存以下建议 6，并给主机配置 swap
#BUILD_CPUTHREADS=6
